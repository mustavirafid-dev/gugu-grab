{
  "manifest_version": 3,
  "name": "Gugu Grab",
  "version": "1.3.0",
  "description": "One-click MP3 / MP4 grab for YouTube and Shorts, powered by your local yt-dlp helper.",
  "minimum_chrome_version": "102",
  "action": {
    "default_title": "Gugu Grab"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.youtube.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
